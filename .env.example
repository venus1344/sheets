PORT=3500
USERS_SPREADSHEET_ID='GOOGLE_SPREADSHEET_ID'
REDIS_URL='redis://localhost:6379'
ADMIN_USER='admin'
ADMIN_PASSWORD='your-secure-password'

# Slack incoming webhook for incident import failures. Leave empty to disable.
SLACK_WEBHOOK_URL=''
# How long to batch failures into one alert (ms). 0 sends one alert per failure.
SLACK_FAILURE_DIGEST_MS=30000

# Shared secret that exempts a request from the IP rate limit when sent in the
# X-Client-Id header (used by the Airflow DAGs). Leave empty to disable the bypass.
INTERNAL_CLIENT_ID='generate-a-long-random-string'
